@@ -0,0 +1,38 @@
+"""Local exact-build acceptance; unsupported pairs and schema drift fail closed."""
+import plistlib
+
+import pytest
+
+from tests.support.schemas import account_case
+from wechat_bridge.adapters import wechat_4_1
+from wechat_bridge.core.errors import BridgeError
+
+
+@pytest.mark.parametrize("version,build,accepted", [
+    ("4.2.0", "270350", True),
+    ("4.2.0", "270349", False),
+    ("4.2.0", "270351", False),
+    ("4.1.15", "270350", False),
+    ("4.2.0", "270135", False),
+    ("4.2.1", "270350", False),
+])
+def test_installed_exact_pair(tmp_path, monkeypatch, version, build, accepted):
+    cfg = account_case(tmp_path)
+    info = tmp_path / "Info.plist"
+    info.write_bytes(plistlib.dumps({"CFBundleShortVersionString": version, "CFBundleVersion": build}))
+    monkeypatch.setattr(wechat_4_1, "INFO_PLIST", info)
+    if accepted:
+        adapter = wechat_4_1.open_adapter(cfg)
+        assert adapter.build == "270350"
+        assert list(adapter.conversations())
+    else:
+        with pytest.raises(BridgeError, match="unsupported_build"):
+            wechat_4_1.open_adapter(cfg)
+
+
+def test_new_build_still_rejects_incompatible_schema(tmp_path):
+    cfg = account_case(tmp_path, changes={
+        "contact/contact.db": "ALTER TABLE contact RENAME COLUMN username TO unknown_column",
+    })
+    with pytest.raises(BridgeError, match="unsupported_schema"):
+        wechat_4_1.open_adapter(cfg, build="270350")
